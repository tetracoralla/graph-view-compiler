{
  "name": "@openadam/graph-view-compiler",
  "version": "0.3.0",
  "description": "A deterministic renderer-neutral graph view compiler for typed product graphs.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "openAdam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetracoralla/graph-view-compiler.git"
  },
  "homepage": "https://github.com/tetracoralla/graph-view-compiler#readme",
  "bugs": {
    "url": "https://github.com/tetracoralla/graph-view-compiler/issues"
  },
  "keywords": [
    "graph",
    "graph-layout",
    "graph-visualization",
    "deterministic",
    "compiler",
    "renderer-neutral",
    "diagram",
    "dagre"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./semantic": {
      "types": "./dist/semantic.d.ts",
      "import": "./dist/semantic.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "docs/COMPATIBILITY.md",
    "docs/SEMANTIC_GRAPH.md",
    "docs/ENGINE_SELECTION.md",
    "docs/PRODUCT_MODEL.md",
    "docs/NORTH_STAR.md",
    "docs/COMPILER.md",
    "docs/PAIN_CASES.md",
    "docs/PERFORMANCE.md",
    "docs/RELEASING.md",
    "CHANGELOG.md",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:examples": "node scripts/check-examples.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:packed-install": "node scripts/check-packed-install.mjs",
    "measure:compiler": "npm run build && node scripts/measure-compiler.mjs",
    "sync:consumers": "node scripts/sync-consumers.mjs",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm test && npm run build && npm run check:examples && npm run check:release && npm run check:packed-install"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
